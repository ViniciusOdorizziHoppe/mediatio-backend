# ─── SERVIDOR ───────────────────────────────────────────────
NODE_ENV=production
PORT=8000

# ─── FRONTEND (CORS) ─────────────────────────────────────────
FRONTEND_URL=https://mediato-nexus-ai.lovable.app

# ─── MONGODB ATLAS ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@cluster.mongodb.net/mediatio?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=gere_uma_chave_com_minimo_32_caracteres_aqui
JWT_REFRESH_SECRET=gere_outra_chave_diferente_aqui

# ─── CLOUDINARY (cloud: df9b2qd9x) ──────────────────────────
# Acesse: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=df9b2qd9x
CLOUDINARY_API_KEY=SUA_API_KEY_CLOUDINARY
CLOUDINARY_API_SECRET=SUA_API_SECRET_CLOUDINARY

# ─── MORPH API (imagens com IA) ──────────────────────────────
MORPH_API_URL=https://morph-one-tan.vercel.app
MORPH_API_KEY=sua_chave_morph

# ─── DIFY / NEXUS AI ─────────────────────────────────────────
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DIFY_KNOWLEDGE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Z-API (WhatsApp - Substituindo Evolution) ──────────────
ZAPI_INSTANCE=seu_instance_id
ZAPI_TOKEN=seu_token_instancia
ZAPI_CLIENT_TOKEN=seu_client_token_painel
BOT_KEY=mediatio-bot-2026
BOT_USER_ID=id_do_usuario_admin_mongodb

# ─── GOOGLE SHEETS (opcional) ────────────────────────────────
